{
  "name": "opencode-queue",
  "version": "0.1.0",
  "description": "A user-owned task queue for OpenCode 2 that the agent can work through sequentially, unattended.",
  "license": "MIT",
  "files": [
    "src",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "exports": {
    ".": "./src/server.ts",
    "./server": "./src/server.ts",
    "./tui": "./src/tui.tsx"
  },
  "scripts": {
    "dev": "opencode .",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint --deny-warnings .",
    "typecheck": "tsc --noEmit",
    "test": "node --test \"test/*.test.ts\"",
    "check": "bun run format:check && bun run lint && bun run typecheck && bun run test"
  },
  "dependencies": {
    "proper-lockfile": "^4.1.2"
  },
  "devDependencies": {
    "@opencode/plugin": "2.0.1",
    "@opencode/theme": "2.0.1",
    "@opentui/core": "^0.5.10",
    "@opentui/solid": "^0.5.10",
    "@types/node": "^26.4.0",
    "@types/proper-lockfile": "^4.1.4",
    "oxfmt": "^0.65.0",
    "oxlint": "^1.80.0",
    "solid-js": "1.9.12",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=22.18.0"
  }
}
